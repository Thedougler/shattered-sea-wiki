{
  "excludeDynamicSections": true,
  "permissions": {
    "allow": [
      "Bash(node *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(mkdir -p *)",
      "Bash(qmd:*)",
      "Bash(obsidian *)",
      "Bash(markdownlint-cli2 *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/nick/ai-os/shattered-sea/.claude/hooks/validate-frontmatter.sh"
          },
          {
            "type": "command",
            "command": "bash /Users/nick/ai-os/shattered-sea/.claude/hooks/qmd-reindex.sh"
          },
          {
            "type": "command",
            "command": "bash /Users/nick/ai-os/shattered-sea/.claude/hooks/regen-index.sh"
          },
          {
            "type": "command",
            "command": "bash /Users/nick/ai-os/shattered-sea/.claude/hooks/format-python.sh"
          },
          {
            "type": "command",
            "command": "bash /Users/nick/ai-os/shattered-sea/.claude/hooks/lint-python.sh"
          },
          {
            "type": "command",
            "command": "bash /Users/nick/ai-os/shattered-sea/.claude/hooks/check-wikilinks.sh"
          },
          {
            "type": "command",
            "command": "bash /Users/nick/ai-os/shattered-sea/.claude/hooks/biome-fix.sh"
          }
        ]
      }
    ]
  }
}
