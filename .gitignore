.DS_Store
.env
.env.*
!.env.example

# Local assistant/runtime settings
.claude/settings.local.json

# Obsidian per-vault config (workspace layout, plugin state, cache)
.obsidian/

# Python/cache artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.mypy_cache/
.ruff_cache/

# Node/package artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Raw uncut session recordings (>100MB) — use git-lfs or store externally
# Chunked session audio (<10MB each) is tracked normally
audio/sessions/*.mp3
audio/sessions/*.wav

# live-co-dm capture scratch (audio + provisional transcript). The canonical
# finalized transcript is committed separately as wiki/sessions/session-NN-transcript.md.
wiki/sessions/.live/

# voice-transcription tool virtualenv
voice-transcription/.venv/
tools/audio/.venv/
.agents/

# Package build output
packages/*/dist/

player-view/.venv/

# Astro UI build output
ui/dist/
ui/.astro/
*.egg-info
