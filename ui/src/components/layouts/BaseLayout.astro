---
import '../../styles/global.css';
import SearchDialog from '../search/SearchDialog.tsx';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Shattered Sea</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen" style={`background: var(--color-bg-primary)`}>
    <!-- Mobile header -->
    <header
      class="lg:hidden sticky top-0 z-40 flex items-center justify-between px-4 py-3 border-b"
      style={`background: var(--color-bg-secondary); border-color: var(--color-border)`}
    >
      <a href="/" class="text-sm font-bold" style={`color: var(--color-accent-gold)`}>Shattered Sea</a>
      <nav class="flex items-center gap-3">
        <a href="/characters/" class="text-xs" style={`color: var(--color-text-secondary)`}>Browse</a>
        <button
          id="mobile-search-trigger"
          class="text-xs px-2 py-1 rounded border"
          style={`border-color: var(--color-border); color: var(--color-text-muted)`}
        >Search</button>
      </nav>
    </header>

    <div class="flex min-h-screen">
      <slot name="sidebar" />
      <main class="flex-1 min-w-0">
        <slot />
      </main>
      <slot name="sidebar-right" />
    </div>

    <SearchDialog client:load />

    <script>
      document.getElementById('mobile-search-trigger')?.addEventListener('click', () => {
        document.dispatchEvent(new KeyboardEvent('keydown', { key: 'k', metaKey: true }));
      });
    </script>
  </body>
</html>
