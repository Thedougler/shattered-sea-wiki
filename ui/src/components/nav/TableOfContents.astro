---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filtered = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{filtered.length > 0 && (
  <div class="mb-6">
    <h3 class="text-xs font-semibold uppercase tracking-wide mb-3" style={`color: var(--color-text-muted)`}>
      On This Page
    </h3>
    <ul class="space-y-1">
      {filtered.map((h) => (
        <li>
          <a
            href={`#${h.slug}`}
            class:list={[
              'block text-sm transition-colors hover:underline',
              h.depth === 3 && 'pl-3',
            ]}
            style={`color: var(--color-text-secondary)`}
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </div>
)}
