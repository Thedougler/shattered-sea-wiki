---
import { getCollection } from 'astro:content';
import { deriveSlug, titleCase } from '@shattered-sea/lib';
import IndexLayout from '../../components/layouts/IndexLayout.astro';
import WikiCard from '../../components/wiki/WikiCard.astro';

const entries = await getCollection(
  'wiki',
  (e) => e.data.type === 'entity' && e.data.subtype === 'item',
);
const sorted = entries.sort((a, b) =>
  (a.data.title || deriveSlug(a.id)).localeCompare(b.data.title || deriveSlug(b.id)),
);
---

<IndexLayout title="Items" description="Weapons, armor, magic items, and equipment" count={sorted.length}>
  {sorted.map((entry) => {
    const slug = deriveSlug(entry.id);
    return (
      <WikiCard
        slug={slug}
        title={entry.data.title || titleCase(slug)}
        summary={entry.data.summary}
        status={entry.data.status}
        subtype={entry.data.item_type}
        tags={entry.data.tags}
      />
    );
  })}
</IndexLayout>
