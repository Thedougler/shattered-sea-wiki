---
import { getCollection } from 'astro:content';
import IndexLayout from '../../components/layouts/IndexLayout.astro';
import WikiCard from '../../components/wiki/WikiCard.astro';
import { deriveSlug, titleCase } from '@shattered-sea/lib';

const entries = await getCollection('wiki', (e) => e.data.type === 'lore');
const sorted = entries.sort((a, b) =>
  (a.data.title || deriveSlug(a.id)).localeCompare(b.data.title || deriveSlug(b.id))
);
---

<IndexLayout title="Lore" description="World history, cultures, and background essays" count={sorted.length}>
  {sorted.map((entry) => {
    const slug = deriveSlug(entry.id);
    return (
      <WikiCard
        slug={slug}
        title={entry.data.title || titleCase(slug)}
        summary={entry.data.summary}
        status={entry.data.status}
        tags={entry.data.tags}
      />
    );
  })}
</IndexLayout>
