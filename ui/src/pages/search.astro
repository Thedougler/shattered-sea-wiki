---
import BaseLayout from '../components/layouts/BaseLayout.astro';
import Sidebar from '../components/nav/Sidebar.astro';
---

<BaseLayout title="Search">
  <Sidebar slot="sidebar" />

  <div class="px-6 py-8 lg:px-10 max-w-4xl">
    <h1 class="text-2xl font-bold mb-6" style={`color: var(--color-text-primary)`}>Search</h1>
    <div id="search-container">
      <p class="text-sm" style={`color: var(--color-text-muted)`}>
        Search is available after building the site. Run <code class="px-1.5 py-0.5 rounded text-xs" style={`background: var(--color-bg-tertiary)`}>pnpm build</code> to generate the search index.
      </p>
    </div>
  </div>
</BaseLayout>
