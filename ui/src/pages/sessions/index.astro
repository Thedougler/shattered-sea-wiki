---
import { getCollection } from 'astro:content';
import IndexLayout from '../../components/layouts/IndexLayout.astro';
import WikiCard from '../../components/wiki/WikiCard.astro';
import { deriveSlug, titleCase } from '../../lib/slug-utils';

const entries = await getCollection('wiki', (e) => e.data.type === 'session');
const sorted = entries.sort((a, b) => {
  const aNum = a.data.session_number ?? 999;
  const bNum = b.data.session_number ?? 999;
  if (aNum !== bNum) return aNum - bNum;
  const aBeat = a.data.beat_number ?? 0;
  const bBeat = b.data.beat_number ?? 0;
  return aBeat - bBeat;
});
---

<IndexLayout title="Sessions" description="Session recaps, scene breakdowns, and run guides" count={sorted.length}>
  {sorted.map((entry) => {
    const slug = deriveSlug(entry.id);
    const num = entry.data.session_number ? `Session ${entry.data.session_number}` : undefined;
    return (
      <WikiCard
        slug={slug}
        title={entry.data.title || titleCase(slug)}
        summary={entry.data.summary}
        status={entry.data.status}
        subtype={num}
        tags={entry.data.tags}
      />
    );
  })}
</IndexLayout>
